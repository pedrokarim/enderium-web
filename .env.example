# Copier en `.env.local` à la racine du dépôt. Ce fichier-ci ne contient aucun secret.

# --- Base de données d'Enderium (celle du plugin EnderiumData) -----------------
# Le site la lit avec un compte en LECTURE SEULE ; il n'écrit que dans `link_intents`.
#   sqlite:<chemin du fichier>            développement, base du serveur de test
#   postgres://user:pass@hôte:5432/enderium
#   mysql://user:pass@hôte:3306/enderium  (MariaDB)
ENDERIUM_DB_URL=sqlite:../../../../enderium-core/core/run/plugins/EnderiumData/enderium.db

# --- Lien site -> serveur (docs/contracts/intents.md) --------------------------
# Secret partagé avec le plugin EnderiumLink : signe chaque intention (HMAC-SHA256).
# Générer : `openssl rand -hex 32`. Absent : la console reste en lecture seule.
ENDERIUM_LINK_SECRET=

# --- Session de la console -----------------------------------------------------
# 32 octets au moins. Générer : `openssl rand -base64 48`.
SESSION_SECRET=
# URL publique du site (cookies, redirections).
APP_URL=http://localhost:3100

# --- Ascencia ID (application de type « web », créée dans la console d'Ascencia ID)
ASCENCIA_ISSUER=https://id.ascencia.re
ASCENCIA_CLIENT_ID=
ASCENCIA_CLIENT_SECRET=
ASCENCIA_REDIRECT_URI=http://localhost:3100/auth/callback

# --- Développement seulement ---------------------------------------------------
# Ouvre une connexion locale sans Ascencia ID. Ignoré (et refusé au démarrage)
# dès que NODE_ENV=production.
ENDERIUM_DEV_AUTH=0
